# Copiá este archivo como .env y completá los valores. El .env nunca se sube al repositorio.

# Conexión a PostgreSQL (en Railway: referencia a ${{Postgres.DATABASE_URL}}).
DATABASE_URL=postgres://usuario:clave@localhost:5432/campolog
# true si la base exige SSL desde afuera de su red (no hace falta en la red privada de Railway).
DATABASE_SSL=false

# Secreto para firmar los tokens: un texto largo y aleatorio (al menos 16 caracteres).
JWT_SECRET=
BCRYPT_ROUNDS=10

# Origen del frontend permitido por CORS (varios, separados por coma).
FRONTEND_URL=http://localhost:5173
PORT=3000

# Primer administrador: se crea solo si todavía no existe ninguno (RN1).
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# true para cargar la comisión y las cuentas de demostración (contraseña demo1234).
SEMBRAR_DEMO=false
