{
  "info": {
    "name": "CampoLog — API",
    "description": "Pruebas de los endpoints de CampoLog contra el backend publicado. Usa las cuentas de demostración (contraseña demo1234). Ejecutá los pedidos en orden: los de login guardan el token y 'Crear entrada' guarda el id y la versión para los siguientes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://backend-production-535121a0.up.railway.app/api" },
    { "key": "tokenEstudiante", "value": "" },
    { "key": "tokenDocente", "value": "" },
    { "key": "fecha", "value": "" },
    { "key": "entradaId", "value": "" },
    { "key": "version", "value": "1" }
  ],
  "item": [
    {
      "name": "1. Salud",
      "request": { "method": "GET", "url": "{{baseUrl}}/salud" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 ok', () => pm.response.to.have.status(200));"] } }]
    },
    {
      "name": "2. Login estudiante (ana@campolog.demo)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/login",
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"ana@campolog.demo\",\n  \"password\": \"demo1234\"\n}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('RN5: login correcto', () => pm.response.to.have.status(200));",
        "pm.collectionVariables.set('tokenEstudiante', pm.response.json().token);"
      ] } }]
    },
    {
      "name": "3. Login con contraseña incorrecta (RN6)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/login",
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"bruno@campolog.demo\",\n  \"password\": \"incorrecta1\"\n}" }
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('401 (al quinto intento la cuenta se bloquea 15 minutos: 423)', () => pm.expect([401, 423]).to.include(pm.response.code));"] } }]
    },
    {
      "name": "4. Mi resumen (asistencia, horas y pendientes)",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{tokenEstudiante}}" }], "url": "{{baseUrl}}/mi/resumen" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('RN25-RN27: resumen', () => pm.response.to.have.status(200));",
        "const p = pm.response.json().pendientes;",
        "if (p.length) pm.collectionVariables.set('fecha', p[p.length - 1].fecha);"
      ] } }]
    },
    {
      "name": "5. Mi calendario del mes",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{tokenEstudiante}}" }], "url": "{{baseUrl}}/mi/calendario" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('RN8: calendario', () => pm.response.to.have.status(200));"] } }]
    },
    {
      "name": "6. Crear entrada en un día pendiente",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{tokenEstudiante}}" }, { "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/entradas",
        "body": { "mode": "raw", "raw": "{\n  \"fecha\": \"{{fecha}}\",\n  \"actividad\": \"Prueba desde Postman\",\n  \"descripcion\": \"\",\n  \"horas\": 4,\n  \"etiquetas\": [\"postman\"],\n  \"evidencias\": [{ \"tipo\": \"COMMIT\", \"titulo\": \"Repositorio\", \"url\": \"https://github.com/joaquinmuzzi/CampoLog\" }]\n}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('201 creada, o 409 si ese día ya tiene entrada (RN15)', () => pm.expect([201, 409]).to.include(pm.response.code));",
        "const r = pm.response.json();",
        "if (pm.response.code === 201) { pm.collectionVariables.set('entradaId', r.id); pm.collectionVariables.set('version', r.version); }"
      ] } }]
    },
    {
      "name": "7. Repetir la entrada del mismo día (RN15)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{tokenEstudiante}}" }, { "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/entradas",
        "body": { "mode": "raw", "raw": "{\n  \"fecha\": \"{{fecha}}\",\n  \"actividad\": \"Otra vez el mismo día\",\n  \"descripcion\": \"\",\n  \"horas\": 4,\n  \"etiquetas\": [],\n  \"evidencias\": []\n}" }
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('409 con el id de la entrada existente', () => { pm.response.to.have.status(409); pm.expect(pm.response.json().detalle.id).to.be.a('number'); });"] } }]
    },
    {
      "name": "8. Enviar a revisión (RN19, RN21)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{tokenEstudiante}}" }, { "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/entradas/{{entradaId}}/enviar",
        "body": { "mode": "raw", "raw": "{ \"version\": {{version}} }" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('ENVIADA', () => pm.expect(pm.response.json().estado).to.eql('ENVIADA'));",
        "pm.collectionVariables.set('version', pm.response.json().version);"
      ] } }]
    },
    {
      "name": "9. Login docente (docente@campolog.demo)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/login",
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"docente@campolog.demo\",\n  \"password\": \"demo1234\"\n}" }
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('tokenDocente', pm.response.json().token);"] } }]
    },
    {
      "name": "10. Mis comisiones (docente)",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{tokenDocente}}" }], "url": "{{baseUrl}}/comisiones" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('RN24: solo las suyas', () => pm.response.to.have.status(200));"] } }]
    },
    {
      "name": "11. Estudiantes de la comisión con su situación (RN26)",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{tokenDocente}}" }], "url": "{{baseUrl}}/comisiones/1/estudiantes" }
    },
    {
      "name": "12. Observar sin comentario (RN22)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{tokenDocente}}" }, { "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/entradas/{{entradaId}}/observar",
        "body": { "mode": "raw", "raw": "{ \"version\": {{version}} }" }
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('400: el comentario es obligatorio', () => pm.response.to.have.status(400));"] } }]
    },
    {
      "name": "13. Validar la entrada",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{tokenDocente}}" }, { "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/entradas/{{entradaId}}/validar",
        "body": { "mode": "raw", "raw": "{ \"version\": {{version}}, \"comentario\": \"Bien documentada.\" }" }
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('VALIDADA', () => pm.expect(pm.response.json().estado).to.eql('VALIDADA'));"] } }]
    },
    {
      "name": "14. Validar de nuevo con la versión vieja (RN23)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{tokenDocente}}" }, { "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/entradas/{{entradaId}}/validar",
        "body": { "mode": "raw", "raw": "{ \"version\": {{version}} }" }
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('409 con la versión y el estado actuales', () => pm.response.to.have.status(409));"] } }]
    },
    {
      "name": "15. Exportar la carpeta en CSV (RN28)",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{tokenEstudiante}}" }], "url": "{{baseUrl}}/mi/exportacion" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('CSV', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('text/csv'));"] } }]
    },
    {
      "name": "16. Estudiante intenta listar comisiones (RN24)",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{tokenEstudiante}}" }], "url": "{{baseUrl}}/comisiones" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('403', () => pm.response.to.have.status(403));"] } }]
    }
  ]
}
